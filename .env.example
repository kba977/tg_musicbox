# 必填：从 @BotFather 获取
TG_BOT_TOKEN=

# 访问控制：false（默认）时只有白名单里的用户 / 群能用；true 时所有人可用
# 不知道 ID 的话，先私聊 bot（或在群里 /music），bot 会回复对应的 ID
PUBLIC_ACCESS=false
# 逗号分隔的用户 ID，例如 123456789,987654321
ALLOWED_USERS=
# 逗号分隔的群 ID（通常以 -100 开头），群里所有人都能用
ALLOWED_CHATS=

# 可选：访问网易云时使用的代理，VPS 所在地区被网易云限制时配置
# 支持 http://user:pass@host:port 或 socks5://host:port
NETEASE_PROXY=

# 可选：file_id 缓存位置（默认 data/cache.db）、同时下载数、日志级别
# CACHE_DB=data/cache.db
# MAX_DOWNLOADS=5
# LOG_LEVEL=INFO
